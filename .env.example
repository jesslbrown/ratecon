# =============================================================================
# RateCon environment variables
#
# Copy this file to `.env.local` and fill in real values for local development.
# Never commit .env.local — it is git-ignored.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# The canonical public URL of the app. Used for OAuth redirects, Stripe
# checkout return URLs, and email links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase (auth + Postgres + storage)
# -----------------------------------------------------------------------------
# Found in Supabase project settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Anthropic (rate-con extraction)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# The model used for runtime extraction. Pin to Sonnet for cost control —
# Opus is reserved for engineering work, never runtime.
ANTHROPIC_MODEL=claude-sonnet-4-6

# -----------------------------------------------------------------------------
# Stripe (subscriptions)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs for the two plans. Create these in the Stripe dashboard with a
# 14-day trial and no upfront card collection.
STRIPE_PRICE_SOLO=
STRIPE_PRICE_PLUS=

# -----------------------------------------------------------------------------
# Resend (transactional email + magic links)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
# Verified sending domain — e.g. invoices@ratecon.app
RESEND_FROM_EMAIL=
